# Copiar a .env y reemplazar cada REEMPLAZAR. El .env real NUNCA se commitea.

# --- Puerto publicado al host ------------------------------------------------
# nginx (en el host) hace proxy_pass contra http://192.168.0.195:APP_PORT
APP_PORT=3110

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=documentos_sig

# Rol OWNER: dueño del esquema. Migraciones y seeds solamente.
# No se pone en el environment del contenedor de la app.
POSTGRES_OWNER_USER=documentos_owner
POSTGRES_OWNER_PASSWORD=REEMPLAZAR

# Rol APP: runtime. Sin BYPASSRLS, sin DDL, sólo los GRANT de la migración 0002.
# Se crea a mano una vez (ver README → "Base de datos").
POSTGRES_APP_USER=documentos_app
POSTGRES_APP_PASSWORD=REEMPLAZAR

# Cadena que usa la app en runtime (rol app, host = nombre del servicio compose)
DATABASE_URL=postgres://documentos_app:REEMPLAZAR@db:5432/documentos_sig

# Cadena del owner — SOLO para migrar/seedear, se pasa puntual por docker exec:
#   docker exec -e DATABASE_URL_OWNER='postgres://documentos_owner:REEMPLAZAR@db:5432/documentos_sig' \
#     documentos-sig-app npm run db:migrate
# DATABASE_URL_OWNER=postgres://documentos_owner:REEMPLAZAR@db:5432/documentos_sig

# --- Auth.js -----------------------------------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=REEMPLAZAR
# Corre detrás de nginx sobre HTTP interno, no HTTPS directo.
AUTH_TRUST_HOST=true
AUTH_URL=http://documentos-sig.sica
